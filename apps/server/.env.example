# Copy to .env (never commit it) and load with e.g. `node --env-file=.env --import tsx src/main.ts`

# Demo mode: in-memory Cardano emulator, demo wallets, simulated schedules.
# DEMO=1

# Cardano network for real deployments. Preprod is the default.
NETWORK=Preprod
# Mainnet needs ALLOW_MAINNET=1 (real-money betting requires a gambling licence).
# ALLOW_MAINNET=1

# Chain provider: Blockfrost if a project id is set, otherwise Koios (no key).
# BLOCKFROST_PROJECT_ID=preprodXXXXXXXXXXXXXXXXXXXXXXXX
# KOIOS_URL=https://preprod.koios.rest/api/v1

# 24-word mnemonic of the operator wallet. It creates and seeds markets,
# signs resolutions and runs the batcher. Fund it with test ADA from the faucet.
OPERATOR_SEED="word1 word2 ... word24"

# Public URL, used in CIP-68 token metadata.
PUBLIC_URL=https://flightradar.fun

# Live positions (readsb v2 API). adsb.lol data is ODbL licensed: attribution required.
ADSB_BASE_URL=https://api.adsb.lol
# ADSB_FALLBACK_URL=
ROUTE_BASE_URL=https://api.adsbdb.com

# Flight schedules for delay and cancellation markets (RapidAPI key).
# AERODATABOX_KEY=

# Market maker
SEED_ADA=20
SEED_ADA_CANCELLATION=100
FEE_BPS=300
MAX_TOTAL_ADA=50000
MAX_TOTAL_ADA_CANCELLATION=5000
MAX_OPEN_MARKETS=200
MARKET_REQUESTS_PER_HOUR=30
CLAIM_WINDOW_DAYS=90

PORT=8787
DATA_DIR=data
# Serve the built web app from the API server:
# WEB_DIST=../web/dist
